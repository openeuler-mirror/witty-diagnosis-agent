# 后端服务配置（复制为 .env 后按需修改）

# --- HTTP ---
PORT=8787
HOST=0.0.0.0

# --- 存储后端（可插拔：sqlite 默认 / mysql 可选）BC-010/NFR-010 ---
DB_CLIENT=sqlite
# SQLite 数据文件（默认 ~/.witty-diagnosis-agent/database/witty.db）BC-011
DB_SQLITE_PATH=
# MySQL（DB_CLIENT=mysql 时必填）
DB_MYSQL_HOST=127.0.0.1
DB_MYSQL_PORT=3306
DB_MYSQL_USER=witty
DB_MYSQL_PASSWORD=
DB_MYSQL_DATABASE=witty

# --- 调度 / 任务 ---
SCHEDULER_MAX_CONCURRENT=4
TASK_RETENTION_DAYS=30
RUNNER_TASK_TIMEOUT_MS=1800000

# --- 诊断驱动（02 §D-001/§D-002）---
# mock（默认）：确定性阶段时序模拟，无需模型/opencode，便于联调执行流程 + 报告内嵌。
# opencode：真实路径，每任务 createOpencode + 重定向 HOME/XDG 隔离，驱动 xuanyuan 全链路
#           （Fuxi→Dayu→Kuafu→Baize→report_visualization），双信号判定完成并采集 HTML 报告。
TASK_DRIVER=opencode
# 真实路径每任务专属 HOME 根目录（隔离根，默认 ~/.witty-diagnosis-agent/task-homes）
TASK_OPENCODE_HOME_BASE=
# 绑定到 xuanyuan 的模型（缺省走 opencode 平台默认/env，如 anthropic/claude-opus-4-8）
TASK_MODEL=
# 报告/叙述输出语言：zh（默认）| en
TASK_OUTPUT_LANGUAGE=zh
# 真实路径 opencode server 启动超时（ms）
TASK_OPENCODE_SERVER_TIMEOUT_MS=60000

# --- 上传 ---
UPLOAD_DIR=
UPLOAD_DISK_QUOTA_BYTES=53687091200

# --- 认证（骨架：dev 占位单用户；生产对接 OIDC/LDAP）FR-001 ---
AUTH_PROVIDER=dev

# --- 已知问题对话查询（QA）可选模块（FR-011 / 02 §6.3）---
# 总开关：true 才注册 /api/qa 路由并在前端显示「已知问题查询」导航；默认 false（未启用则入口隐藏，BC-001）
CONVERSATION_ENABLED=false
CONVERSATION_MAX_CONCURRENT=10
CONVERSATION_TIMEOUT_MS=120000
CONVERSATION_QUESTION_MAX_CHARS=4000
# QA 常驻 opencode server 专属 HOME（默认 ~/.witty-diagnosis-agent/qa-home）
QA_OPENCODE_HOME=
# LightRAG 知识检索：未配置 LIGHTRAG_ENDPOINT 时默认走内置 mock（LIGHTRAG_MOCK=true）便于联调
LIGHTRAG_MOCK=
LIGHTRAG_ENDPOINT=
LIGHTRAG_API_KEY=
LIGHTRAG_API_KEY_HEADER=X-API-Key
LIGHTRAG_TIMEOUT_MS=120000
LIGHTRAG_QUERY_MODE=mix
LIGHTRAG_RESPONSE_TYPE=Multiple Paragraphs
LIGHTRAG_INCLUDE_CHUNK_CONTENT=true
