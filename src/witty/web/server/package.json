{
  "name": "witty-diagnosis-web-server",
  "version": "0.1.0",
  "private": true,
  "description": "智能诊断前端 Web 服务 — 后端 API (Fastify + Knex)",
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "knex migrate:latest --knexfile knexfile.cjs",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/multipart": "^8.3.0",
    "@opencode-ai/sdk": "^1.1.19",
    "better-sqlite3": "^11.3.0",
    "fastify": "^4.28.1",
    "knex": "^3.1.0",
    "mysql2": "^3.11.0",
    "uuid": "^9.0.1",
    "which": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/uuid": "^9.0.8",
    "@types/which": "^3.0.4",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
