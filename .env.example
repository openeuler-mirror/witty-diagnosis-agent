# =============================================================================
# DeepSeek API 配置（必需）
# =============================================================================
# DeepSeek API 是 OpsAgent 的核心 LLM 服务提供商
# 获取 API Key: https://platform.deepseek.com/

# DeepSeek API 密钥（必填）
# 作用：用于调用 DeepSeek 大语言模型服务
# 配置建议：从 DeepSeek 平台获取有效的 API Key
DEEPSEEK_API_KEY=

# DeepSeek API 基础地址
# 作用：指定 DeepSeek API 的服务端点
# 配置建议：通常保持默认值，除非使用自定义部署
DEEPSEEK_BASE_URL="https://api.deepseek.com/"

# DeepSeek 模型名称
# 作用：指定使用的 DeepSeek 模型版本
# 配置建议：推荐使用 "deepseek-chat"，可根据需要选择其他可用模型
DEEPSEEK_MODEL="deepseek-chat"

# =============================================================================
# Langfuse 配置（可选）
# =============================================================================
# Langfuse 提供 LLM 调用追踪和可观测性功能
# 获取凭据：https://cloud.langfuse.com/ 或自部署实例
# Langfuse 公钥（可选）
# 作用：用于 Langfuse 服务认证
# 配置建议：如需使用 LLM 调用追踪功能，请填写有效的公钥
LANGFUSE_PUBLIC_KEY=

# Langfuse 私钥（可选）
# 作用：用于 Langfuse 服务认证
# 配置建议：与公钥配对使用，确保安全性
LANGFUSE_SECRET_KEY=

# Langfuse 服务地址（可选）
# 作用：指定 Langfuse 服务的 URL
# 配置建议：使用云服务保持默认，自部署时修改为对应地址
LANGFUSE_HOST=https://cloud.langfuse.com

# =============================================================================
# Skill配置
# =============================================================================
# 自定义技能路径
# 作用：指定存放用户自定义技能的目录路径
# 配置建议：使用绝对路径，确保目录存在且有读写权限。默认为项目根目录下的 custom_skills 目录
CUSTOM_SKILL_PATHS={project_root}/custom_skills

# =============================================================================
# LightRAG 知识检索配置（运维问答 ops-agent 依赖）
# =============================================================================
# ops-agent 的 `lightrag_query` 原生工具据此对接 LightRAG REST /query
# （接口见 http://localhost:9621/redoc#tag/query）。

# LightRAG 服务端点
# 作用：检索请求 POST 到 {LIGHTRAG_ENDPOINT}/query
# 默认：http://localhost:9621
LIGHTRAG_ENDPOINT=http://localhost:9621

# LightRAG API Key
# 作用：随请求头（默认 X-API-Key）发送的鉴权密钥
LIGHTRAG_API_KEY=lightrag1234

# API Key 请求头名（可选，默认 X-API-Key；如需 Bearer 可设为 Authorization）
LIGHTRAG_API_KEY_HEADER=X-API-Key

# 检索模式（可选）：local | global | hybrid | naive | mix | bypass，默认 mix
LIGHTRAG_QUERY_MODE=mix

# 单次检索超时毫秒（可选，默认 30000）
LIGHTRAG_TIMEOUT_MS=30000

# 期望回答格式（可选，透传给 LightRAG，默认 "Multiple Paragraphs"）
LIGHTRAG_RESPONSE_TYPE="Multiple Paragraphs"

# 是否附带引用 chunk 原文（可选，默认 true；设 false 关闭）
LIGHTRAG_INCLUDE_CHUNK_CONTENT=true

# 走内置 mock 知识而非真实服务（可选，联调用；设 true 启用）
# LIGHTRAG_MOCK=false
# =============================================================================
# 已知问题分析（Shennong / 神农）配置（可选，opt-in）
# =============================================================================
# 配置 CASE_KB_ID 后，会自动启用「已知问题分析」能力：
#   - 注册神农 (Shennong) 子 Agent 与 case_search MCP 工具；
#   - 伏羲 (Fuxi) 在故障模式构建 (1.4) 阶段会先检索知识库中的历史相似案例，
#     用历史故障模式辅助诊断规划。
# 不配置 CASE_KB_ID 时，上述能力全部关闭，Fuxi 走原诊断流程（默认行为）。
#
# 重要：这些是“进程环境变量”，必须能被【启动 opencode 的 shell】读到才生效。
#   - 推荐写入 ~/.zshrc / ~/.bashrc 后，新开终端再启动 opencode；
#   - 或在同一个 shell 内先 `export ...` 再运行 opencode；
#   - opencode.json 的顶层没有 env 注入字段，写在那里【无效】。
#   - 运行中修改环境变量对已启动的实例无效，需重启 opencode。

# 知识库 ID（启用开关，必填才会启用本功能）
# 作用：指定要检索的「已知问题」知识库；为空则整套功能关闭。
CASE_KB_ID=

# RAG 服务根地址（可选）
# 作用：/json/search 接口所在的 euler-copilot-rag 服务地址。
# 配置建议：不填默认为 http://127.0.0.1:8000；示例：http://123.60.114.28:32389
CASE_API_BASE_URL=

# 访问凭证（可选）
# 作用：当 RAG 服务需要鉴权时，作为 access_key 请求头发送；服务无鉴权时留空即可。
CASE_ACCESS_KEY=

# 请求超时毫秒数（可选）
# 作用：单次 /json/search 请求的超时时间；不填默认为 15000。
CASE_API_TIMEOUT_MS=

# 检索返回的案例数量 top_k（可选）
# 作用：单次 /json/search 检索返回的相似案例数量上限（top_k）。
# 配置建议：不填或填入非正整数时默认为 5。
CASE_TOP_K=

# 案例落盘目录（可选）
# 作用：命中的历史案例原文（name/content/content_after_preprocess）会被写成一个 md 文件，
#       供后续 Kuafu 读取，避免把大 JSON 塞进上下文。此处指定该文件的存放目录。
# 配置建议：不填默认为 ~/.witty-diagnosis-agent/shennong/cases
CASE_CASES_DIR=