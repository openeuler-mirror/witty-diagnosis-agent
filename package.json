{
  "name": "witty-diagnosis-agent",
  "version": "0.1.0-beta",
  "description": "Witty Diagnosis Agent - OpenCode Plugin",
  "keywords": [
    "witty-diagnosis-agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/openeuler/witty-diagnosis-agent.git"
  },
  "license": "MIT",
  "author": "witty-diagnosis-agent",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "witty-diagnosis-agent": "dist/cli/index.js"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "files": [
    "dist",
    "postinstall.mjs",
    "skills"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli/index.ts --format esm --out-dir dist --dts && npm run build:schema",
    "clean": "rm -rf dist",
    "postinstall": "node postinstall.mjs",
    "typecheck": "tsc --noEmit",
    "build:schema": "tsx script/build-schema.ts"
  },
  "dependencies": {
    "@ast-grep/cli": "^0.40.0",
    "@ast-grep/napi": "^0.40.0",
    "@clack/prompts": "^1.0.1",
    "@code-yeongyu/comment-checker": "^0.6.1",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@opencode-ai/plugin": "^1.1.19",
    "@opencode-ai/sdk": "^1.1.19",
    "better-sqlite3": "^12.6.2",
    "commander": "^14.0.2",
    "detect-libc": "^2.0.0",
    "diff": "^8.0.3",
    "js-yaml": "^4.1.1",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.2",
    "vscode-jsonrpc": "^8.2.0",
    "which": "^6.0.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.3.3",
    "@types/picomatch": "^3.0.2",
    "@types/which": "^3.0.4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  },
  "trustedDependencies": [
    "@ast-grep/cli",
    "@ast-grep/napi",
    "@code-yeongyu/comment-checker"
  ]
}
