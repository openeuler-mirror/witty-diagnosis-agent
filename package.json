{
  "name": "witty-diagnosis-agent",
  "version": "0.8.0-beta",
  "description": "Witty Diagnosis Agent - OpenCode Plugin",
  "keywords": [
    "witty-diagnosis-agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/openeuler/witty-diagnosis-agent.git"
  },
  "license": "MulanPSL-2.0",
  "author": "witty-diagnosis-agent",
  "engines": {
