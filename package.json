    "@opencode-ai/sdk": "^1.1.19",
    "commander": "^14.0.2",
    "jsonc-parser": "^3.3.1",
    "marked": "^17.0.5",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
