{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.gitcode.com/openeuler/witty-diagnosis-agent/raw/master/assets/witty-diagnosis-agent.schema.json",
  "title": "Witty Diagnosis Agent Configuration",
  "description": "Configuration schema for witty-diagnosis-agent plugin",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "output_language": {
      "default": "zh",
      "type": "string",
      "enum": [
        "zh",
        "en"
      ]
    },
    "agents": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "disable": {
            "type": "boolean"
          },
          "extra_instructions": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "disabled_agents": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disabled_mcps": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills_dir": {
      "default": "skills",
      "type": "string"
    },
    "report": {
      "type": "object",
      "properties": {
        "output_dir": {
          "default": "baize/reports",
          "type": "string"
        },
        "formats": {
          "default": [
            "md",
            "html"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "md",
              "html"
            ]
          }
        }
      },
      "required": [
        "output_dir",
        "formats"
      ],
      "additionalProperties": false
    },
    "guards": {
      "type": "object",
      "properties": {
        "md_only": {
          "default": true,
          "type": "boolean"
        },
        "output_truncate_chars": {
          "default": 30000,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "compaction_preserve": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "md_only",
        "output_truncate_chars",
        "compaction_preserve"
      ],
      "additionalProperties": false
    },
    "orchestration": {
      "type": "object",
      "properties": {
        "max_parallel_subagents": {
          "default": 2,
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "subagent_timeout_minutes": {
          "default": 30,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "max_parallel_subagents",
        "subagent_timeout_minutes"
      ],
      "additionalProperties": false
    },
    "notification": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "output_language",
    "agents",
    "disabled_agents",
    "disabled_mcps",
    "skills_dir",
    "report",
    "guards",
    "orchestration",
    "notification"
  ],
  "additionalProperties": false
}